{
  "name": "boardhub-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BoardHub Online \u2014 plataforma de juegos de mesa en el navegador.",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "compartir": "node scripts/compartir.mjs",
    "worker:dev": "vite build && wrangler dev",
    "test:worker": "node --test tests/server.test.js",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21",
    "wrangler": "^4.164.0"
  }
}
