{
  // BoardHub en Cloudflare Workers: web + salas en tiempo real (Durable Objects).
  // Publicar:  npm run deploy   →  https://boardhub.<tu-subdominio>.workers.dev
  "name": "boardhub",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] }
  ],
  // Tope de mesas abiertas a la vez (ver server/core/limits.js). Cambiar acá y volver a publicar.
  "vars": { "MAX_ROOMS": "10" },
  "observability": { "enabled": true }
}
